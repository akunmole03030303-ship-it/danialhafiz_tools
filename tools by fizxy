#!/system/bin/sh
# ---------------------------------------------------
#  SCRIPT BY : FIZXY_TOOLS
#  REBORN v12.9 - HYBRID JOINER & LAG BYPASS
# ---------------------------------------------------

PLACE_ID_1="97598239454123"
PLACE_ID_2="121864768012064"

# DETEKSI OTOMATIS SEMUA PACKAGE YANG BERAWALAN com.roblox
APPS=$(pm list packages | grep "com.roblox" | cut -d ":" -f2)

if [ -z "$APPS" ]; then
    echo "[!] Error: Tidak ada aplikasi Roblox (com.roblox*) yang terdeteksi!"
    exit 1
fi

CFG="/data/data/com.termux/files/home/roblox_config"

# TIMER CACHE
LAST_CC=$(date +"%H:%M:%S")
EXPIRE=$(($(date +%s) + 1800))

# HITUNG JUMLAH APLIKASI ROBLOX YANG TERDETEKSI
TOTAL_APPS=0
for PKG in $APPS; do
    TOTAL_APPS=$((TOTAL_APPS + 1))
done

# MENU PILIHAN MAP (PUBLIC SERVER)
clear
echo "======================================================="
echo "       ROBLOX MULTI-INSTANCE AUTO JOINER"
echo "======================================================="
echo " Pilih Map untuk Public Server:"
echo " 1. Grow A Garden 2"
echo " 2. Fish It"
echo "======================================================="
echo -n "[?] Masukkan pilihan Map (1/2): "
read MAP_CHOICE

if [ "$MAP_CHOICE" = "1" ]; then
    PUBLIC_PLACE_ID="$PLACE_ID_1"
    MAP_NAME="Grow A Garden 2"
elif [ "$MAP_CHOICE" = "2" ]; then
    PUBLIC_PLACE_ID="$PLACE_ID_2"
    MAP_NAME="Fish It"
else
    echo "[!] Pilihan Map tidak valid!"
    exit 1
fi

# MENU PILIHAN METODE JOIN
clear
echo "======================================================="
echo "       ROBLOX MULTI-INSTANCE AUTO JOINER"
echo "======================================================="
echo " Map Terpilih           : $MAP_NAME"
echo " Jumlah Roblox terdeteksi : $TOTAL_APPS Aplikasi"
echo " Silakan pilih metode join:"
echo " 1. Join public melalui Place ID ($MAP_NAME)"
echo " 2. Join private server yang sama (1 Link untuk semua)"
echo " 3. Join private server beda-beda tiap akun ($TOTAL_APPS Link)"
echo "======================================================="
echo -n "[?] Masukkan pilihan (1/2/3): "
read MENU_CHOICE

if [ -z "$MENU_CHOICE" ]; then
    echo "[!] Input tidak boleh kosong!"
    exit 1
fi

case "$MENU_CHOICE" in
    1)
        LINK="roblox://experiences/start?placeId=$PUBLIC_PLACE_ID"
        echo "[+] Mode Terpilih: PUBLIC SERVER ($MAP_NAME)"
        ;;
    2)
        echo -n "[?] Tempel/Paste link VIP/Private Server: "
        read SHARED_LINK
        if [ -z "$SHARED_LINK" ]; then
            echo "[!] Link tidak boleh kosong!"
            exit 1
        fi
        echo "[+] Mode Terpilih: PRIVATE SERVER SAMA (1 LINK)"
        ;;
    3)
        echo "[+] Mode Terpilih: PRIVATE SERVER BERBEDA-BEDA ($TOTAL_APPS AKUN)"
        echo "-------------------------------------------------------"
        i=1
        for PKG in $APPS; do
            echo -n "[?] Masukkan link private untuk akun ke-$i ($PKG): "
            read LINK_INPUT
            if [ -z "$LINK_INPUT" ]; then
                echo "[!] Link tidak boleh kosong!"
                exit 1
            fi
            eval "LINK_ACC_$i=\"\$LINK_INPUT\""
            i=$((i + 1))
        done
        echo "-------------------------------------------------------"
        ;;
    *)
        echo "[!] Pilihan tidak valid!"
        exit 1
        ;;
esac

# TWEAK: Turunin kecerahan layar ke 0 secara paksa biar HP gak overheat/thermal throttling
echo "[*] Optimizing hardware temperature (Dimming Screen)..."
settings put system screen_brightness 0 > /dev/null 2>&1

sleep 1

panel() {
    clear
    local RAM=$(free -m | awk '/Mem:/ { print $3 "/" $2 "MB" }')
    local JAM=$(date +"%H:%M:%S")
    
    echo -e "\e[1;36m┌───────────────────────────────────────────────────┐\e[0m"
    echo -e "\e[1;32m             [ ROBLOX MANAGER BY FIZXY ]            \e[0m"
    echo -e "\e[1;36m├───────────────────────────────────────────────────┤\e[0m"
    echo -e "\e[1;33m > RAM DEVICE      : $RAM\e[0m"
    echo -e "\e[1;33m > LAST CLEAN      : $LAST_CC\e[0m"
    echo -e "\e[1;33m > TIME            : $JAM\e[0m"
    echo -e "\e[1;36m├───────────────────────────────────────────────────┤\e[0m"
    echo -e "\e[1;37m   PACKAGE NAME               |       STATUS        \e[0m"
    echo -e "\e[1;36m├───────────────────────────────────────────────────┤\e[0m"
    
    for PKG in $APPS; do
        if pm list packages | grep -q "$PKG"; then
            local PID=$(pidof $PKG)
            if [ -z "$PID" ]; then
                STATUS="\e[1;31mOFFLINE\e[0m"
            else
                STATUS="\e[1;32mONLINE \e[0m"
            fi
            printf "   \e[1;37m%-26s\e[0m |       %b\n" "$PKG" "$STATUS"
        fi
    done
    echo -e "\e[1;36m└───────────────────────────────────────────────────┘\e[0m"
}

# AUTO REFRESH CACHE
cc_auto() {
    local SKRG=$(date +%s)
    if [ $SKRG -ge $EXPIRE ]; then
        echo -e "\e[1;34m[*] Cleaning cache & boosting RAM system...\e[0m"
        for PKG in $APPS; do
            [ -d "/data/data/$PKG/cache" ] && rm -rf /data/data/$PKG/cache/* 2>/dev/null
        done
        
        # TWEAK: Bersihkan RAM cache dari kernel sistem Android agar memory lega
        echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
        
        LAST_CC=$(date +"%H:%M:%S")
        EXPIRE=$(($SKRG + 1800))
        sleep 1
    fi
}

# KILL SISA PROSES AWAL
for PKG in $APPS; do 
    pm list packages | grep -q "$PKG" && am force-stop $PKG 2>/dev/null
done

# MAIN LOOP
INDEX=0
while :; do
    cc_auto
    
    INDEX=0
    for PKG in $APPS; do
        INDEX=$((INDEX + 1))
        if pm list packages | grep -q "$PKG"; then
            PID=$(pidof $PKG)

            if [ -z "$PID" ]; then
                echo -e "\e[1;31m[!] $PKG dead. Restarting...\e[0m"
                
                # TENTUKAN LINK BERDASARKAN PILIHAN MENU
                if [ "$MENU_CHOICE" = "1" ]; then
                    CURRENT_LINK="roblox://experiences/start?placeId=$PUBLIC_PLACE_ID"
                elif [ "$MENU_CHOICE" = "2" ]; then
                    CURRENT_LINK="$SHARED_LINK"
                elif [ "$MENU_CHOICE" = "3" ]; then
                    eval "CURRENT_LINK=\$LINK_ACC_$INDEX"
                fi
                
                # INJECT CONFIG
                mkdir -p /data/data/$PKG/shared_prefs/
                if [ -f "$CFG/${PKG}_config.xml" ]; then
                    cp -f "$CFG/${PKG}_config.xml" "/data/data/$PKG/shared_prefs/com.roblox.client.xml"
                    chmod 444 "/data/data/$PKG/shared_prefs/com.roblox.client.xml"
                fi
                
                # METODE ADAPTASI SCRIPT LAMA (MONKEY + SPECIFIC INTENT TARGET)
                # Langkah 1: Pancing bangun aplikasinya dulu
                monkey -p $PKG -c android.intent.category.LAUNCHER 1 > /dev/null 2>&1
                sleep 2
                
                # Langkah 2: Tembak link server dengan flag target package (-p) yang akurat
                am start -a android.intent.action.VIEW -d "$CURRENT_LINK" -p $PKG > /dev/null 2>&1
                
                # OOM ADJUST & CPU TWEAK (ANTI-LAG)
                sleep 2
                NPID=$(pidof $PKG)
                if [ -n "$NPID" ]; then
                    echo "-1000" > /proc/$NPID/oom_score_adj 2>/dev/null
                    renice -n 19 -p $NPID > /dev/null 2>&1
                fi
                
                sleep 10  # Jeda sebelum lanjut klon berikutnya
            fi
        fi
    done
    
    panel
    sleep 5
done
